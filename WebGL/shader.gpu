// Vertex shader
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;
attribute vec3 tan;
attribute vec2 coordinates;

uniform mat4 ModelViewProjectionMatrix;
uniform mat4 normalMatrix;

varying vec3 var_position;
varying vec3 var_normal;
varying vec3 var_tan;
varying vec2 var_coordinates;

void main() {
    var_normal = normalize((normalMatrix * vec4(normal, 0.0)).xyz);
    var_tan = normalize((normalMatrix * vec4(tan, 0.0)).xyz);;
    var_position = (ModelViewProjectionMatrix * vec4(vertex, 1.0)).xyz;
    var_coordinates = coordinates;
    gl_Position = ModelViewProjectionMatrix * vec4(vertex, 1.0);
}
`;


// Fragment shader
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
   precision highp float;
#else
   precision mediump float;
#endif

varying vec3 var_position;
varying vec3 var_normal;
varying vec3 var_tan;
varying vec2 var_coordinates;
uniform vec3 lightPos;  
uniform vec3 viewerPos;
uniform vec4 color; 

uniform sampler2D diffuseTexture;
uniform sampler2D specularTexture;
uniform sampler2D normalTexture;

mat3 calculateTBN(vec3 normal, vec3 tan) {
    vec3 N = normalize(normal);
    vec3 T = normalize(tan - dot(tan, N) * N);      // Orthogonalize the tangent to the normal
    vec3 B = cross(N, T);                           // Calculate the bitangent as a vector product
    return mat3(T, B, N); 
}

void main() {
    float materialShininess = 100.0;

    vec3 lightDirection = normalize(lightPos - var_position);
    vec3 viewDirection = normalize(viewerPos - var_position);

    vec3 ambientLight = vec3(0.0, 0.0, 0.0);

    // Read normals from textures + Transform
    vec3 sampledNormal = 2.0 * texture2D(normalTexture, var_coordinates).xyz - vec3(1.0, 1.0, 1.0);
    mat3 TBNMatrix = calculateTBN(var_normal, var_tan);
    vec3 transformedNormal = normalize(TBNMatrix * sampledNormal);
    
    // Diffuse
    float diffuseFactor = max(dot(transformedNormal, lightDirection), 0.0);
    vec3 diffuseColor = diffuseFactor * texture2D(diffuseTexture, var_coordinates).rgb;

    // Specular
    vec3 reflectedLight = reflect(-lightDirection, transformedNormal);
    float specularFactor = pow(max(dot(viewDirection, reflectedLight), 0.0), materialShininess);
    vec3 specularColor = specularFactor * texture2D(specularTexture, var_coordinates).rgb;

    // Підсумовуємо кольори та задаємо результат
    gl_FragColor = vec4(ambientLight + diffuseColor + specularColor, 1.0);
}
`;
