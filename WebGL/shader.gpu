

// Vertex shader
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;

uniform mat4 ModelViewProjectionMatrix;
uniform mat4 normalMatrix;

varying vec3 var_position;
varying vec3 var_normal;

void main() {
    var_normal = normalize((normalMatrix * vec4(normal, 0.0)).xyz);
    var_position = (ModelViewProjectionMatrix * vec4(vertex, 1.0)).xyz;
    gl_Position = ModelViewProjectionMatrix * vec4(vertex, 1.0);
}
`;


// Fragment shader
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
   precision highp float;
#else
   precision mediump float;
#endif

varying vec3 var_position;
varying vec3 var_normal;

uniform vec3 lightPos;  
uniform vec3 viewerPos;
uniform vec4 color; 

void main() {
    float shininess = 100.0; 

    vec3 N = normalize(var_normal);
    vec3 L = normalize(lightPos - var_position);
    vec3 V = normalize(viewerPos - var_position);

    vec3 ambientColor = 0.5 * vec3(0.5, 0.2, 0.7);

    float lambertian = max(dot(N, L), 0.0);
    vec3 diffuseColor = 0.8 * lambertian * vec3(0.7, 0.4, 0.9);

    float specular = 0.0;
    if (lambertian > 0.0) {
        vec3 R = reflect(-L, N); 
        float specAngle = max(dot(V, R), 0.0);
        specular = pow(specAngle, shininess);
    }

    vec3 specularColor = 0.5 * specular * vec3(1.0, 1.0, 1.0);

    vec3 finalColor = ambientColor + diffuseColor + specularColor;
    gl_FragColor = vec4(finalColor, 1.0);
}
`;